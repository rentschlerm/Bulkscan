{
  "expo": {
    "name": "BulkScan",
    "slug": "bulkscan",
    "version": "1.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1116",
    "android": {
      "package": "com.rentschler.bulkscan",
      "versionCode": 7,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1116"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "BulkScan uses the camera to photograph meals and scan barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BulkScan reads photos of meals you pick from your gallery."
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "icon": "./assets/icon.png"
  }
}
